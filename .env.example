# Copy to .env and fill in values. Do not commit .env.
# Gamma + CLOB base URLs default to Polymarket production in code; set GAMMA_API_URL / CLOB_API_URL only if you need a different host.

# Required: Polygon wallet private key (hex, with or without 0x).
# CLOB API credentials are derived/created from this key at startup.
PRIVATE_KEY=

# 0 = EOA (normal wallet). Use 1 or 2 only for Polymarket proxy flows; then set PROXY_WALLET_ADDRESS if the client requires it.
SIGNATURE_TYPE=0

# --- Trading ---
# Required: market slug from the Polymarket event URL
TRADING_SLUG=

# false / unset = simulation (no real orders). true = live orders (same as npm run start:live or --no-simulation). CLI flags override this.
TRADING_LIVE=false

# true = repeat first+second cycles until exit; false = one pair then idle
TRADING_CONTINUOUS=false

TRADING_CHECK_INTERVAL_MS=1000
TRADING_TRAILING_STOP_POINT=0.03
TRADING_STOP_LOSS_POINT=0.03
TRADING_TRAILING_SHARES=100
TRADING_FIXED_TRADE_AMOUNT=10
